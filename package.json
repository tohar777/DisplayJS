{
    "name": "displayjs",
    "version": "0.1.0",
    "description": "A JavaScript/TypeScript display library",
    "type": "module",
    "main": "./dist/displayjs.umd.js",
    "module": "./dist/displayjs.js",
    "types": "./dist/displayjs.d.ts",
