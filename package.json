        "dist"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build"
    },
    "devDependencies": {
        "vite": "^7.0.0",
        "vite-plugin-dts": "^4.5.0",
        "typescript": "^5.0.0"
    }
}